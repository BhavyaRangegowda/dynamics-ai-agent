# Jira configuration
JIRA_URL=https://your-jira-instance.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-jira-api-token
PROJECT_KEY=KAN
JIRA_MAX_RESULTS=50

# Groq AI configuration
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Dynamics 365 configuration
DYNAMICS_URL=https://your-dynamics-instance.crm.dynamics.com
DYNAMICS_USERNAME=your.username@example.com
DYNAMICS_PASSWORD=your-password

# Selenium and screenshot settings
SCREENSHOT_DIR=screenshots
MFA_WAIT_SECONDS=30
TEST_DATA_PREFIX=AI_Test

# Email settings
EMAIL_SENDER=sender@example.com
EMAIL_PASSWORD=your-email-password
EMAIL_RECIPIENTS=recipient@example.com
EMAIL_SMTP_HOST=smtp.office365.com
EMAIL_SMTP_PORT=587

# Optional
SLACK_WEBHOOK_URL=
ZEPHYR_ENABLED=false
ZEPHYR_API_TOKEN=
STORY_HASH_FILE=story_hashes.json
TEST_EMAIL_DOMAIN=testcorp.com
TEST_LEAD_PREFIX=AI_Lead
TEST_CONTACT_PREFIX=AI_Contact
TEST_COMPANY_PREFIX=AI_Testing_Corp
